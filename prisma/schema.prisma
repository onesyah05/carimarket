generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum AdminPermissionKey {
  SUPPORT_READ
  SUPPORT_REPLY
  MODERATION_REVIEW
  CONTENT_DRAFT
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

/**
 * Token Threads jangka pendek (1 jam) hanya dipakai bila penukaran ke token
 * jangka panjang gagal. Koneksi seperti itu tetap bisa dipakai, tetapi harus
 * ditingkatkan atau dihubungkan ulang sebelum kedaluwarsa.
 */
enum ThreadsTokenKind {
  SHORT_LIVED
  LONG_LIVED
}

enum SearchCapability {
  LOCAL_DATA
  SELF_ONLY
  PUBLIC_SEARCH
}

enum KeywordKind {
  INCLUDE
  EXCLUDE
}

enum SearchFrequency {
  MANUAL
  HOURLY
  DAILY
}

enum SearchRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum LeadStatus {
  NEW
  SAVED
  REPLIED
  ARCHIVED
}

enum ReplyStatus {
  DRAFT
  FLAGGED
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  SENDING
  SENT
  SIMULATED_SENT
  FAILED
  CANCELLED
}

enum ReplyMode {
  REVIEW_FIRST
  AUTO_SEND
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/** Asal kredensial API: diterbitkan Superadmin, atau dibuat pengguna sendiri. */
enum ApiCredentialSource {
  SUPERADMIN
  USER_LOGIN
  USER_PAIRING
}

enum NotificationType {
  LEAD_DISCOVERED
  REPLY_SENT
  REPLY_FAILED
  MODERATION_DECISION
  QUOTA_WARNING
}

model User {
  id                 String                  @id @default(cuid())
  email              String                  @unique @db.VarChar(191)
  name               String                  @db.VarChar(120)
  passwordHash       String?                 @db.VarChar(255)
  role               Role                    @default(USER)
  status             AccountStatus           @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?                @db.DateTime(3)
  emailIsPlaceholder Boolean                  @default(false)
  lastLoginAt        DateTime?                @db.DateTime(3)
  suspendedAt        DateTime?                @db.DateTime(3)
  createdAt          DateTime                 @default(now()) @db.DateTime(3)
  updatedAt          DateTime                 @updatedAt @db.DateTime(3)
  deletedAt          DateTime?                @db.DateTime(3)
  businessProfile    BusinessProfile?
  notification       NotificationPreference?
  notifications      Notification[]
  replyAutomation    ReplyAutomationSetting?
  sessions           Session[]
  threadsConnections ThreadsConnection[]
  keywords           Keyword[]
  searchRuns         SearchRun[]
  leads              Lead[]
  replyDrafts        ReplyDraft[]             @relation("ReplyOwner")
  reviewedReplies    ReplyDraft[]             @relation("ReplyReviewer")
  adminPermissions   AdminPermission[]
  subscriptions      Subscription[]
  monthlyUsage       MonthlyUsage[]
  usageEvents        UsageEvent[]
  apiCredentials     ApiCredential[]          @relation("ApiCredentialOwner")
  mobilePairingCodes MobilePairingCode[]
  issuedApiCredentials ApiCredential[]        @relation("ApiCredentialIssuer")
  authoredArticles   Article[]                @relation("ArticleAuthor")
  approvedArticles   Article[]                @relation("ArticleApprover")
  blacklistTerms     BlacklistTerm[]          @relation("BlacklistAuthor")
  supportTickets     SupportTicket[]           @relation("TicketRequester")
  assignedTickets    SupportTicket[]           @relation("TicketAssignee")
  supportMessages    SupportMessage[]
  auditLogs          AuditLog[]                @relation("AuditActor")

  @@index([role, status])
  @@index([createdAt])
}

model AdminPermission {
  id         String             @id @default(cuid())
  userId     String
  permission AdminPermissionKey
  createdAt  DateTime           @default(now()) @db.DateTime(3)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([permission])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(191)
  expiresAt DateTime @db.DateTime(3)
  ipHash    String?  @db.VarChar(191)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model BlacklistTerm {
  id         String   @id @default(cuid())
  term       String   @db.VarChar(120)
  normalized String   @db.VarChar(120)
  reason     String?  @db.VarChar(255)
  isActive   Boolean  @default(true)
  createdById String?
  createdAt  DateTime @default(now()) @db.DateTime(3)
  createdBy  User?    @relation("BlacklistAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([normalized])
  @@index([isActive])
}

model BusinessProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String   @db.VarChar(140)
  category    String   @db.VarChar(100)
  description String   @db.Text
  location    String?  @db.VarChar(140)
  serviceArea String?  @db.VarChar(255)
  brandVoice  String?  @db.VarChar(100)
  onboardingCompletedAt DateTime? @db.DateTime(3)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id            String  @id @default(cuid())
  userId        String  @unique
  emailLead     Boolean @default(true)
  emailReply    Boolean @default(true)
  emailQuota    Boolean @default(true)
  pushEnabled   Boolean @default(false)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReplyAutomationSetting {
  id                String    @id @default(cuid())
  userId            String    @unique
  mode              ReplyMode @default(REVIEW_FIRST)
  minimumScore      Int       @default(90)
  dailyLimit        Int       @default(10)
  delayMinutes      Int       @default(15)
  pauseOnRisk       Boolean   @default(true)
  quietHoursEnabled Boolean   @default(false)
  quietHoursStart   String?   @db.VarChar(5)
  quietHoursEnd     String?   @db.VarChar(5)
  createdAt         DateTime  @default(now()) @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @db.DateTime(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ThreadsConnection {
  id                  String             @id @default(cuid())
  userId              String
  externalAccountId   String?            @unique @db.VarChar(191)
  username            String?            @db.VarChar(100)
  status              ConnectionStatus   @default(PENDING)
  capability          SearchCapability   @default(LOCAL_DATA)
  tokenCiphertext     String?            @db.Text
  tokenIv             String?            @db.VarChar(255)
  tokenAuthTag        String?             @db.VarChar(255)
  tokenKeyVersion     Int?
  tokenKind           ThreadsTokenKind    @default(LONG_LIVED)
  tokenExpiresAt      DateTime?           @db.DateTime(3)
  scopes              Json?
  lastCheckedAt       DateTime?           @db.DateTime(3)
  /// Kode kegagalan terakhir dari Meta (tanpa token/secret), untuk panel Superadmin.
  lastErrorCode       String?             @db.VarChar(100)
  createdAt           DateTime            @default(now()) @db.DateTime(3)
  updatedAt           DateTime            @updatedAt @db.DateTime(3)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchRuns          SearchRun[]

  @@index([userId, status])
  @@index([tokenExpiresAt])
}

model Keyword {
  id          String          @id @default(cuid())
  userId      String
  phrase      String          @db.VarChar(120)
  normalized  String          @db.VarChar(120)
  kind        KeywordKind     @default(INCLUDE)
  frequency   SearchFrequency @default(HOURLY)
  isActive    Boolean         @default(true)
  lastRunAt   DateTime?       @db.DateTime(3)
  nextRunAt   DateTime?       @db.DateTime(3)
  createdAt   DateTime        @default(now()) @db.DateTime(3)
  updatedAt   DateTime        @updatedAt @db.DateTime(3)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchRuns  SearchRun[]
  leadMatches LeadKeywordMatch[]

  @@unique([userId, normalized, kind])
  @@index([userId, isActive, nextRunAt])
}

model SearchRun {
  id           String             @id @default(cuid())
  userId       String
  keywordId    String?
  connectionId String?
  capability   SearchCapability
  status       SearchRunStatus    @default(QUEUED)
  resultCount  Int                @default(0)
  errorCode    String?            @db.VarChar(100)
  startedAt    DateTime?          @db.DateTime(3)
  completedAt  DateTime?          @db.DateTime(3)
  createdAt    DateTime           @default(now()) @db.DateTime(3)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword      Keyword?           @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  connection   ThreadsConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ThreadPost {
  id             String   @id @default(cuid())
  externalPostId String   @unique @db.VarChar(191)
  authorHandle   String   @db.VarChar(100)
  authorName     String?  @db.VarChar(140)
  body           String   @db.Text
  permalink      String   @db.VarChar(512)
  likeCount      Int?
  replyCount     Int?
  repostCount    Int?
  postedAt       DateTime @db.DateTime(3)
  capturedAt     DateTime @default(now()) @db.DateTime(3)
  leads          Lead[]

  @@index([postedAt])
  @@index([authorHandle])
}

model Lead {
  id             String       @id @default(cuid())
  userId         String
  threadPostId   String
  status         LeadStatus   @default(NEW)
  relevanceScore Decimal      @db.Decimal(5, 2)
  matchReason    String?      @db.VarChar(255)
  sourceMode     SearchCapability
  discoveredAt   DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadPost     ThreadPost    @relation(fields: [threadPostId], references: [id], onDelete: Restrict)
  keywordMatches LeadKeywordMatch[]
  replyDrafts    ReplyDraft[]

  @@unique([userId, threadPostId])
  @@index([userId, status, discoveredAt])
  @@index([relevanceScore])
}

model LeadKeywordMatch {
  id        String  @id @default(cuid())
  leadId    String
  keywordId String
  score     Decimal @db.Decimal(5, 2)
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([leadId, keywordId])
  @@index([keywordId])
}

model ReplyDraft {
  id             String       @id @default(cuid())
  leadId         String
  userId         String
  reviewedById   String?
  body           String       @db.Text
  version        Int          @default(1)
  status         ReplyStatus  @default(DRAFT)
  deliveryMode   ReplyMode    @default(REVIEW_FIRST)
  aiModel        String?      @db.VarChar(100)
  scheduledFor   DateTime?    @db.DateTime(3)
  approvedAt     DateTime?    @db.DateTime(3)
  sentAt         DateTime?    @db.DateTime(3)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user           User         @relation("ReplyOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy     User?        @relation("ReplyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  attempts       ReplyDeliveryAttempt[]
  moderationFlags ModerationFlag[]

  @@index([userId, status, updatedAt])
  @@index([scheduledFor, status])
}

model ReplyDeliveryAttempt {
  id              String      @id @default(cuid())
  replyDraftId    String
  status          ReplyStatus
  idempotencyKey  String      @unique @db.VarChar(191)
  externalReplyId String?     @db.VarChar(191)
  errorCode       String?     @db.VarChar(100)
  retryCount      Int         @default(0)
  attemptedAt     DateTime    @default(now()) @db.DateTime(3)
  replyDraft      ReplyDraft  @relation(fields: [replyDraftId], references: [id], onDelete: Cascade)

  @@index([replyDraftId, attemptedAt])
}

model ModerationFlag {
  id           String     @id @default(cuid())
  replyDraftId String
  ruleCode     String     @db.VarChar(100)
  reason       String     @db.VarChar(255)
  resolvedAt   DateTime?  @db.DateTime(3)
  createdAt    DateTime   @default(now()) @db.DateTime(3)
  replyDraft   ReplyDraft @relation(fields: [replyDraftId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, createdAt])
}

model Plan {
  id                   String         @id @default(cuid())
  code                 String         @unique @db.VarChar(50)
  name                 String         @db.VarChar(100)
  monthlyPrice         Decimal        @db.Decimal(12, 2)
  monthlySearchLimit   Int
  monthlyReplyLimit    Int
  keywordLimit         Int
  /// Jarak minimum antar pencarian terjadwal (jam). Paket menentukan seberapa
  /// cepat kata kunci boleh dijalankan ulang; pengguna hanya dapat memilih
  /// lebih jarang, tidak lebih sering.
  searchIntervalHours  Int            @default(24)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now()) @db.DateTime(3)
  updatedAt            DateTime       @updatedAt @db.DateTime(3)
  subscriptions        Subscription[]
}

model Subscription {
  id                  String             @id @default(cuid())
  userId              String
  planId              String
  status              SubscriptionStatus @default(TRIAL)
  providerReference   String?            @unique @db.VarChar(191)
  currentPeriodStart  DateTime           @db.DateTime(3)
  currentPeriodEnd    DateTime           @db.DateTime(3)
  cancelledAt         DateTime?          @db.DateTime(3)
  createdAt           DateTime           @default(now()) @db.DateTime(3)
  updatedAt           DateTime           @updatedAt @db.DateTime(3)
  user                User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan                Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([currentPeriodEnd])
}

model MonthlyUsage {
  id            String   @id @default(cuid())
  userId        String
  periodStart   DateTime @db.Date
  searchCount   Int      @default(0)
  replyCount    Int      @default(0)
  updatedAt     DateTime @updatedAt @db.DateTime(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
}

model UsageEvent {
  id           String   @id @default(cuid())
  userId       String
  type         String   @db.VarChar(60)
  units        Int      @default(1)
  referenceId  String?  @db.VarChar(191)
  occurredAt   DateTime @default(now()) @db.DateTime(3)
  metadata     Json?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, occurredAt])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique @db.VarChar(100)
  slug     String    @unique @db.VarChar(120)
  articles Article[]
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique @db.VarChar(100)
  slug     String       @unique @db.VarChar(120)
  articles ArticleTag[]
}

model Article {
  id              String        @id @default(cuid())
  authorId        String
  approvedById    String?
  categoryId      String?
  title           String        @db.VarChar(191)
  slug            String        @unique @db.VarChar(191)
  excerpt         String?       @db.VarChar(500)
  content         String        @db.LongText
  coverImageUrl   String?       @db.VarChar(512)
  metaTitle       String?       @db.VarChar(191)
  metaDescription String?       @db.VarChar(320)
  status          ArticleStatus @default(DRAFT)
  scheduledFor    DateTime?     @db.DateTime(3)
  publishedAt     DateTime?     @db.DateTime(3)
  createdAt       DateTime      @default(now()) @db.DateTime(3)
  updatedAt       DateTime      @updatedAt @db.DateTime(3)
  author          User          @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  approvedBy      User?         @relation("ArticleApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags            ArticleTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model SupportTicket {
  id          String         @id @default(cuid())
  requesterId String
  assigneeId  String?
  subject     String         @db.VarChar(191)
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)
  requester   User           @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages    SupportMessage[]

  @@index([status, priority, updatedAt])
  @@index([requesterId])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  authorId  String
  body      String        @db.Text
  isInternal Boolean      @default(false)
  createdAt DateTime      @default(now()) @db.DateTime(3)
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

/**
 * Kredensial API untuk aplikasi mobile.
 *
 * Hanya Superadmin yang menerbitkan. Kunci disimpan sebagai hash SHA-256;
 * nilai aslinya hanya ditampilkan satu kali saat penerbitan dan tidak pernah
 * dapat dibaca ulang. `keyPrefix` dipakai untuk mengenali kunci di panel.
 */
model ApiCredential {
  id          String    @id @default(cuid())
  /** Workspace pengguna yang dapat diakses kunci ini. */
  userId      String
  /** Superadmin yang menerbitkan. */
  createdById String?
  name        String    @db.VarChar(120)
  source      ApiCredentialSource @default(SUPERADMIN)
  keyPrefix   String    @db.VarChar(24)
  keyHash     String    @unique @db.VarChar(191)
  lastUsedAt  DateTime? @db.DateTime(3)
  expiresAt   DateTime? @db.DateTime(3)
  revokedAt   DateTime? @db.DateTime(3)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  user        User      @relation("ApiCredentialOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("ApiCredentialIssuer", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([keyPrefix])
  @@index([source, revokedAt])
}

/**
 * Kode pemasangan aplikasi mobile.
 *
 * Pengguna membuat kode berumur pendek dari dashboard web, lalu memasukkannya
 * di aplikasi untuk menukarnya dengan token perangkat. Dipakai pengguna yang
 * masuk lewat Threads sehingga belum punya kata sandi. Hanya hash kode yang
 * disimpan dan kode hanya dapat ditukar satu kali.
 */
model MobilePairingCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique @db.VarChar(191)
  expiresAt DateTime  @db.DateTime(3)
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String           @db.VarChar(191)
  body      String           @db.VarChar(500)
  href      String?          @db.VarChar(255)
  readAt    DateTime?        @db.DateTime(3)
  createdAt DateTime         @default(now()) @db.DateTime(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String   @db.VarChar(120)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.VarChar(191)
  ipHash      String?  @db.VarChar(191)
  metadata    Json?
  createdAt   DateTime @default(now()) @db.DateTime(3)
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  email     String   @db.VarChar(191)
  company   String?  @db.VarChar(140)
  message   String   @db.Text
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([createdAt])
}

/**
 * Rahasia tingkat platform (bukan per-pengguna) yang diisi Superadmin.
 * Nilai disimpan terenkripsi AES-256-GCM; kolom *Ciphertext tidak pernah
 * dikembalikan ke klien. Dipakai untuk integrasi Threads tidak resmi
 * (web session) sebelum Meta menyetujui App Review.
 */
model PlatformSecret {
  id              String   @id @default(cuid())
  key             String   @unique @db.VarChar(120)
  valueCiphertext String   @db.Text
  valueIv         String   @db.VarChar(64)
  valueAuthTag    String   @db.VarChar(64)
  valueKeyVersion Int      @default(1)
  note            String?  @db.VarChar(255)
  lastCheckedAt   DateTime? @db.DateTime(3)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  updatedAt       DateTime @updatedAt @db.DateTime(3)

  @@index([key])
}
