DATABASE_URL="mysql://carimarket:change-me@127.0.0.1:3306/carimarket"
# Threads OAuth wajib HTTPS. Jalankan `npm run dev:https` untuk lokal.
NEXT_PUBLIC_APP_URL="https://localhost:3000"
# Buat dengan: openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# Ambil "Threads App ID" dan "Threads App Secret" dari Meta App Dashboard > App settings > Basic.
# Jangan gunakan App ID/Secret untuk produk Meta lain.
THREADS_APP_ID=""
THREADS_APP_SECRET=""
THREADS_GRAPH_URL="https://graph.threads.net/v1.0"
# Penilaian kecocokan lead dengan profil bisnis (OpenCode Zen).
# Kosongkan untuk mematikan penilaian AI: skor turun ke heuristik kata kunci
# dan lead tetap masuk feed, hanya tanpa vonis "cocok menurut AI".
# Model tier gratis OpenCode tidak dapat dipakai dari server, jadi AI_MODEL
# harus model berbayar dan akunnya perlu bersaldo.
AI_API_KEY=""
AI_BASE_URL="https://opencode.ai/zen/v1"
AI_MODEL="claude-haiku-5-5"
# Pendaftaran akun baru lewat OAuth Threads. Setel "false" agar OAuth hanya
# menghubungkan akun yang sudah masuk (tanpa membuat akun baru).
THREADS_SIGNUP_ENABLED="true"
INTEGRATION_MODE="live"
# Nonaktifkan worker latar: WORKER_ENABLED="false"
# Interval siklus worker (ms, minimum 15000): WORKER_INTERVAL_MS="60000"
# Batas pemakaian harian tingkat platform, di bawah batas Meta per 24 jam
# (2.200 pencarian, ~1.000 balasan per akun Threads yang terhubung). Naikkan
# hanya bila akun Threads yang dipakai memang lebih dari satu.
PLATFORM_DAILY_SEARCH_LIMIT="2000"
PLATFORM_DAILY_REPLY_LIMIT="900"
# Bukti pembayaran disimpan di luar repo agar tidak terhapus saat deploy.
# Bawaan: <direktori aplikasi>/storage/payment-proofs
PAYMENT_PROOF_DIR=""

# Pengiriman email lewat Resend (verifikasi pendaftaran, pengaturan ulang kata
# sandi, salinan notifikasi). Tanpa RESEND_API_KEY email tidak terkirim:
# pendaftaran menampilkan tombol kirim ulang, dan halaman lupa kata sandi
# menolak permintaan dengan pesan agar menghubungi dukungan. Domain pengirim
# harus sudah terverifikasi di Resend.
RESEND_API_KEY=""
EMAIL_FROM="Cari Market <noreply@carimarket.id>"
