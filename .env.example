DATABASE_URL="mysql://carimarket:change-me@127.0.0.1:3306/carimarket"
# Threads OAuth wajib HTTPS. Jalankan `npm run dev:https` untuk lokal.
NEXT_PUBLIC_APP_URL="https://localhost:3000"
# Buat dengan: openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# Ambil "Threads App ID" dan "Threads App Secret" dari Meta App Dashboard > App settings > Basic.
# Jangan gunakan App ID/Secret untuk produk Meta lain.
THREADS_APP_ID=""
THREADS_APP_SECRET=""
THREADS_GRAPH_URL="https://graph.threads.net/v1.0"
AI_API_KEY=""
# Pendaftaran akun baru lewat OAuth Threads. Setel "false" agar OAuth hanya
# menghubungkan akun yang sudah masuk (tanpa membuat akun baru).
THREADS_SIGNUP_ENABLED="true"
INTEGRATION_MODE="live"
# Nonaktifkan worker latar: WORKER_ENABLED="false"
# Interval siklus worker (ms, minimum 15000): WORKER_INTERVAL_MS="60000"
